# Run npm run local:init to create .env with random local credentials.
BASE_URL=http://localhost:8080
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=replace-with-local-admin-password
ESPOCRM_DATE_FORMAT=DD.MM.YYYY
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=espocrm
DB_USER=espocrm
DB_PASSWORD=replace-with-local-database-password
DB_ROOT_PASSWORD=replace-with-local-root-password
DB_READ_USER=espocrm_test
DB_READ_PASSWORD=replace-with-local-readonly-password
HTTP_PORT=8080
WORKERS=2
# Optional API-user credentials. Defaults to Basic auth with the local admin.
# ESPOCRM_API_KEY=
# Writes are refused outside loopback unless this is explicitly set:
# ALLOW_REMOTE_WRITES=true
