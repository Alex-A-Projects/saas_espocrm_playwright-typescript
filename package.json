{
  "name": "espocrm-playwright-typescript",
  "version": "1.0.0",
  "private": true,
  "description": "EspoCRM UI, API and MariaDB integration tests with Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:ui:demo": "DEMO_UI=1 playwright test --project=ui-demo",
    "test:ui:sales": "SALES_UI=1 playwright test --project=ui-sales",
    "report:sales": "playwright show-report playwright-report-sales",
    "test:api": "playwright test --project=api",
    "test:db": "playwright test --project=database",
    "test:smoke": "playwright test --grep @smoke",
    "test:cross-browser": "CROSS_BROWSER=1 playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --project=ui-chromium --debug",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "report:demo": "playwright show-report playwright-report-demo",
    "typecheck": "tsc --noEmit",
    "local:init": "tsx scripts/init-env.ts",
    "local:up": "docker compose up -d --wait --wait-timeout 300 && tsx scripts/provision-db.ts && tsx scripts/wait-ready.ts && tsx scripts/configure-mail.ts",
    "local:mail": "tsx scripts/configure-mail.ts",
    "local:db-user": "tsx scripts/provision-db.ts",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs --tail=100",
    "seed:ui": "tsx scripts/seed-ui.ts",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "dotenv": "18.0.1",
    "mysql2": "3.24.4",
    "tsx": "4.23.13",
    "typescript": "~5.9.3"
  }
}
